# Salin menjadi .env untuk development di laptop (jangan commit .env).
# Database lewat SSH tunnel:  ssh -N -L 5433:127.0.0.1:5432 ubuntu@43.157.235.41
# Password kebun_app ada di ~/stack/kebun.env di VPS.
DATABASE_URL=postgres://kebun_app:PASSWORD@127.0.0.1:5433/kebun

# Minimal 32 karakter acak:  openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

PORT=3000
PHOTOS_DIR=./data/photos
